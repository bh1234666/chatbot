          </div>
          <pre class="preview-text">${escapeHtml(state.ui.projectPreviewText || state.ui.projectCommandOutput || "")}</pre>
        </div>
      </div>
    </div>
  `;
}

function renderProjectTreeItem(item) {
  const isDir = item.type === "dir";
