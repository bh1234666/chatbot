        <input id="projectDiffCompareInput" placeholder="diff 瀵规瘮鏂囦欢锛屽彲绌? value="${escapeHtml(state.ui.projectDiffComparePath || "")}" />
        <button id="projectDiffBtn" ${hasDir ? "" : "disabled"}>Diff</button>
