# ─────────────────────────────────────────────────────────────────────────
# 环境变量示例。复制为 .env(放在项目根,与 app/ 同级)后按需修改。
# 变量名与默认值由 app/config.py 的 Field(validation_alias=...) 自动抽取,
# 与代码实际读取的名字保证一致。
# ─────────────────────────────────────────────────────────────────────────

# ── 必填 ──
DEEPSEEK_API_KEY=
GPT55_API_KEY=
GPT55_BASE_URL=https://your-gpt-proxy.example.com/v1

# ── 数据库 ──
# 当前仅实现 SQLite 后端。PG(postgresql://...)分支未实现,设了会在启动时报错。
DATABASE_URL=sqlite:///chatbot.db

# ── Redis(已预留但当前代码未使用;水平扩展时启用)──
REDIS_URL=redis://localhost:6379/0

# ── 外部服务 ──
NAPCAT_URL=http://127.0.0.1:5700
CHATBOT_URL=http://localhost:8000

# ── 行为开关 ──
STRICT_ACTIVE_ARCHIVE=true
TOOL_RESULT_TIMESTAMP_MODE=full
LITE_ROUND3_FOR_EASY=true

# ── 工作区 ──
WORKSPACE_AGENT_MAX_BYTES=4294967296

# ── Debug(生产保持 false)──
DEBUG_MODE=false
DEBUG_VERBOSE=false
DEBUG_LOG_DIR=

# ── Helper 并发 / 超时 ──
MAX_HELPERS_CONCURRENT=20
MAX_HELPER_DEPTH=2
HELPER_LONG_RUN_OBSERVE_SEC=1800
HELPER_HARD_KILL_SEC=2700

# ── Macro 升级阈值 ──
MACRO_HARD_ITER=50
MACRO_HARD_TIME_SEC=1800
MACRO_YELLOW_ITER=30
MACRO_YELLOW_TIME_SEC=900

# ── 资源并发 ──
OCR_CONCURRENCY=2
TTS_CONCURRENCY=2

# ── 幂等去重(注意:进程内缓存,仅单 worker 有效)──
IDEMPOTENCY_TTL_SEC=30.0
IDEMPOTENCY_MAX_ENTRIES=5000

# ── Dream 后台整理 ──
DREAM_ENABLED=true
DREAM_TASK_TIMEOUT_SEC=600
DREAM_STEP_TIMEOUT_SEC=30
DREAM_MAX_STEPS_PER_TASK=30
DREAM_INTERRUPT_DEMOTE_THRESHOLD=5
DREAM_CACHE_SUBDIR=.dream_cache
DREAM_EMERGENCY_WORKSPACE_MB=4000
DREAM_IDLE_THRESHOLD_SEC=5
DREAM_LOG_LEVEL=minimal
DREAM_LLM_BUDGET_USD_PER_DAY=5.0
